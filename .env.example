# =============================================================================
# RouteWise AI — Environment Configuration Template
# =============================================================================
# Copy this file to .env before starting the backend.
# NEVER commit .env to Git — it is protected in .gitignore.

# Database: Default SQLite for instant local zero-friction execution.
# To connect to MySQL / PostgreSQL, set:
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=sqlite:///./supplyguard.db

# Security & JWT Authentication
SECRET_KEY=routewise-enterprise-secret-key-2026-hackathon-ibm
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# IBM WatsonX / Bob AI Assistant Integration
# If left blank, RouteWise AI automatically activates the deterministic
# rule-based decision support and local explanation layer with 100% functionality.
IBM_AI_API_KEY=
IBM_BOB_API_URL=

# Server Configuration
APP_PORT=8000
APP_ENV=development
